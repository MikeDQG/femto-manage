# Supabase > Project Settings > Database > Connection string > URI
# Use the session pooler host, port and username exactly as shown by Supabase.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/postgres
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
SPRING_DATASOURCE_SSLMODE=require
