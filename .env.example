SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:PORT/postgres
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
SPRING_DATASOURCE_SSLMODE=require

# Optional initial administrator; set both values. Never commit actual credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Set true when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false
